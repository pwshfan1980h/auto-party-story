{
  "name": "auto-party-story",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "tsc",
    "test": "vitest run",
    "sim": "node --import tsx tools/sim.ts",
    "golden": "node --import tsx tools/golden.ts",
    "baselines": "node --import tsx tools/baselines.ts",
    "tune": "node --import tsx tools/tune.ts",
    "campaign": "node --import tsx tools/game-campaign.ts",
    "balance:orders": "node --import tsx tools/order-diagnostics.ts",
    "balance:viability": "node --import tsx tools/viability.ts",
    "test:browser": "node tools/browser-check.cjs",
    "test:build": "node tools/build-smoke.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.170.0",
    "playwright": "1.64.1",
    "tsx": "^4.19.2",
    "typescript": "5.6",
    "vite": "^6.4.4",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "three": "^0.170.0"
  }
}
