        { "label": "Harvest them to sell", "reward": 0.4, "risk": 0.05, "outcomes": [ { "chance": 1, "loot": { "items": 1, "each": 10 }, "say": "A pouch of glowing caps." } ] },
        { "label": "Leave them", "reward": 0, "risk": 0, "outcomes": [ { "chance": 1, "say": "Better safe." } ] }
