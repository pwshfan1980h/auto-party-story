        { "label": "Listen", "reward": 0.5, "risk": 0.3, "outcomes": [ { "chance": 0.7, "reveal": true, "say": "Now you know what waits." }, { "chance": 0.3, "hurt": { "pct": 0.08 }, "reveal": true, "say": "They whisper true, and it costs you." } ] },
