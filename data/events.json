    { "id": "offering", "text": "An old shrine with an empty offering bowl. The air around it is warm.",
      "choices": [
        { "label": "Offer something from the pack", "reward": 0.6, "risk": 0.1, "needsPack": true, "outcomes": [ { "chance": 1, "dropItem": { "n": 1 }, "embers": { "n": 1 }, "heal": { "pct": 0.15 }, "say": "The bowl takes it. The warmth stays with you." } ] },
